{
  "name": "color-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/app/server.js",
    "worker": "node --env-file-if-exists=.env src/app/worker.js",
    "maintenance": "node --env-file-if-exists=.env src/app/maintenance.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "build": "node scripts/build.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/*.test.js"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "bullmq": "6.3.12",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "ipaddr.js": "1.9.1",
    "mysql2": "3.24.5",
    "parse5": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "23.0.0",
    "undici": "8.11.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "supertest": "7.3.1"
  }
}
